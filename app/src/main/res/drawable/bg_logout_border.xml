<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：默认淡红细边框 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF9F8" />
            <stroke
                android:width="1.5dp"
                android:color="#E6C2BE" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- 顶层：从水平正中心向左右两边扩散的高亮边框 -->
    <item android:id="@+id/layer_glow_border">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="center">
            <shape android:shape="rectangle">
                <solid android:color="#14E53935" />
                <stroke
                    android:width="2.5dp"
                    android:color="#E53935" />
                <corners android:radius="16dp" />
            </shape>
        </clip>
    </item>

</layer-list>