<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="#1B3B2B"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivLoginLogo"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_logo_box"
                android:contentDescription="@string/bingo_logo"
                android:paddingStart="20dp"
                android:paddingTop="30dp"
                android:paddingEnd="15dp"
                android:paddingBottom="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bingo_logo" />

            <ImageView
                android:id="@+id/ivTextLogo"
                android:layout_width="200dp"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/text_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/bingo_textlogo2" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- 标语 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slogan"
                android:textColor="#1B3B2B"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp" />

            <!-- UM Email 输入框 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UM Email"
                android:textColor="#1B3B2B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="student@siswa.um.edu.my"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#1B3B2B"
                android:textColorHint="#7A8A80"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />

            <!-- Password 输入框 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Password"
                android:textColor="#1B3B2B"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="••••••••••••"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="#1B3B2B"
                android:textColorHint="#7A8A80"
                android:textSize="15sp"
                android:layout_marginBottom="32dp" />

            <!-- 登录按钮 -->
            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_rounded_button"
                app:backgroundTint="@null"
                android:text="Sign in to BinGo ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 注册引导 -->
            <TextView
                android:id="@+id/tvRegisterLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="New to BinGo? Create an account"
                android:textColor="#1B3B2B"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>