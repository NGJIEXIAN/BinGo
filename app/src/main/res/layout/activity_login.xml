<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Green brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@color/green_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Original BinGo logo -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_logo_box"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="BinGo logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/bingo_logo" />

            </FrameLayout>

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAlignment="center"
                android:text="BinGo"
                android:textColor="@color/white"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAlignment="center"
                android:text="A greener campus starts with you"
                android:textColor="#DCEDE3"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Login content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_login_white_gradient"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <!-- Main heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Small actions.\nGreener UM."
                android:textColor="@color/green_dark"
                android:textSize="30sp"
                android:textStyle="bold"
                android:lineSpacingExtra="3dp" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ready to make your campus greener? Start making a difference NOW!"
                android:textColor="@color/green_dark"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- Google sign-in button -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="28dp">

                <Button
                    android:id="@+id/btnSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rounded_button"
                    android:backgroundTint="@color/green_dark"
                    android:gravity="center"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:text="Continue with Google"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/green_dark" />

            </FrameLayout>

            <!-- Student account reminder -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Use your UM student email (@siswa.um.edu.my)"
                android:textSize="12sp"
                android:textStyle="normal" />

            <!-- Bini mascot at bottom-left -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="44dp"
                android:layout_gravity="start"
                android:contentDescription="Bini, BinGo's eco buddy"
                android:scaleType="fitCenter"
                android:src="@drawable/bini_mascot" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:text="Together for a more sustainable UM"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
